<?xml version="1.0" encoding="UTF-8"?>
<definitions name="ClosingDisclosureProcess"
             targetNamespace="http://lendwise.com/soa/closing"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://lendwise.com/soa/closing"
             xmlns:types="http://lendwise.com/soa/closing/types"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype">

    <!-- Import XSD -->
    <types>
        <xsd:schema>
            <xsd:import namespace="http://lendwise.com/soa/closing/types"
                        schemaLocation="xsd/ClosingTypes.xsd"/>
        </xsd:schema>
    </types>

    <!-- Messages -->
    <message name="ClosingDisclosureRequest">
        <part name="cdRequest" element="types:ClosingDisclosureRequestType"/>
    </message>
    <message name="ClosingDisclosureResponse">
        <part name="cdResult" element="types:ClosingDisclosureResultType"/>
    </message>

    <!-- Port Type -->
    <portType name="ClosingDisclosurePortType">
        <operation name="generateClosingDisclosure">
            <input message="tns:ClosingDisclosureRequest"/>
            <output message="tns:ClosingDisclosureResponse"/>
        </operation>
    </portType>

    <!-- SOAP Binding -->
    <binding name="ClosingDisclosureSOAPBinding" type="tns:ClosingDisclosurePortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="generateClosingDisclosure">
            <soap:operation soapAction="http://lendwise.com/soa/closing/generateClosingDisclosure"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <!-- Service -->
    <service name="ClosingDisclosureService">
        <port name="ClosingDisclosurePort" binding="tns:ClosingDisclosureSOAPBinding">
            <soap:address location="http://localhost:7001/soa-infra/services/lendwise/ClosingDisclosureComposite/ClosingDisclosureService"/>
        </port>
    </service>

    <!-- Partner Link Types -->
    <plnk:partnerLinkType name="ClosingDisclosurePLT">
        <plnk:role name="ClosingDisclosureProvider" portType="tns:ClosingDisclosurePortType"/>
    </plnk:partnerLinkType>

    <plnk:partnerLinkType name="PassthroughPLT">
        <plnk:role name="PassthroughProvider" portType="tns:ClosingDisclosurePortType"/>
    </plnk:partnerLinkType>

</definitions>
