<?xml version="1.0" encoding="UTF-8"?>
<con:pipelineEntry xmlns:con="http://www.bea.com/wli/sb/pipeline/config"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config"
                  xmlns:con2="http://www.bea.com/wli/sb/stages/config"
                  xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config">
    <con:coreEntry>
        <con:binding type="AnyXML"/>
    </con:coreEntry>
    <con:router errorHandler="common/faults/FaultHandler">
        <con:pipeline type="request" name="AsyncCallbackRequestPipeline">
            <con:stage name="DispatchCallback">
                <con:context/>
                <con:actions>
                    <con3:assign varName="callbackPayload">
                        <con2:id>id_cb_01</con2:id>
                        <con3:expr>
                            <con2:xqueryText>
                                <DocumentCallbackEvent xmlns="http://lendwise.com/async/callback">
                                    <TrackingToken>{ $body//TrackingToken/text() }</TrackingToken>
                                    <ProcessingStatus>COMPLETED</ProcessingStatus>
                                    <DocumentId>{ $body//DocumentId/text() }</DocumentId>
                                    <CompletionTime>{ fn:current-dateTime() }</CompletionTime>
                                </DocumentCallbackEvent>
                            </con2:xqueryText>
                        </con3:expr>
                    </con3:assign>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:pipeline type="response" name="AsyncCallbackResponsePipeline">
            <con:stage name="LogCallbackAck">
                <con:context/>
                <con:actions/>
            </con:stage>
        </con:pipeline>
        <con:flow>
            <con:pipeline-node name="CallbackNode">
                <con:request>AsyncCallbackRequestPipeline</con:request>
                <con:response>AsyncCallbackResponsePipeline</con:response>
            </con:pipeline-node>
        </con:flow>
    </con:router>
</con:pipelineEntry>
