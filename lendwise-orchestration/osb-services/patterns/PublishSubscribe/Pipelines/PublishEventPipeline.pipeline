<?xml version="1.0" encoding="UTF-8"?>
<con:pipelineEntry xmlns:con="http://www.bea.com/wli/sb/pipeline/config"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config"
                  xmlns:con2="http://www.bea.com/wli/sb/stages/config"
                  xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config"
                  xmlns:con4="http://www.bea.com/wli/sb/stages/publish/config">
    <con:coreEntry>
        <con:binding type="AnyXML"/>
    </con:coreEntry>
    <con:router errorHandler="common/faults/FaultHandler">
        <con:pipeline type="request" name="PublishEventRequestPipeline">
            <con:stage name="ConstructAndPublishEvent">
                <con:context/>
                <con:actions>
                    <con3:assign varName="eventPayload">
                        <con2:id>id_pub_01</con2:id>
                        <con3:expr>
                            <con2:xqueryText>
                                <LoanStatusChangedEvent xmlns="http://lendwise.com/events/loan">
                                    <LoanId>{ $body//LoanId/text() }</LoanId>
                                    <OldStatus>{ $body//OldStatus/text() }</OldStatus>
                                    <NewStatus>{ $body//NewStatus/text() }</NewStatus>
                                    <UpdatedBy>{ $body//UpdatedBy/text() }</UpdatedBy>
                                    <Timestamp>{ fn:current-dateTime() }</Timestamp>
                                </LoanStatusChangedEvent>
                            </con2:xqueryText>
                        </con3:expr>
                    </con3:assign>
                    <!-- Asynchronously Publish to JMS Topic without blocking response -->
                    <con3:publish>
                        <con2:id>id_pub_jms_stage</con2:id>
                        <con3:service ref="patterns/PublishSubscribe/ProxyServices/AuditTopicSubscriberProxy" xsi:type="ref:ProxyServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con3:outboundTransform>
                            <con3:replace varName="body" contents-only="true">
                                <con2:id>id_pub_body_replace</con2:id>
                                <con3:location>
                                    <con2:xpathText>.</con2:xpathText>
                                </con3:location>
                                <con3:expr>
                                    <con2:xqueryText>$eventPayload</con2:xqueryText>
                                </con3:expr>
                            </con3:replace>
                        </con3:outboundTransform>
                    </con3:publish>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:pipeline type="response" name="PublishEventResponsePipeline">
            <con:stage name="ConfirmPublish">
                <con:context/>
                <con:actions/>
            </con:stage>
        </con:pipeline>
        <con:flow>
            <con:pipeline-node name="PublishNode">
                <con:request>PublishEventRequestPipeline</con:request>
                <con:response>PublishEventResponsePipeline</con:response>
            </con:pipeline-node>
        </con:flow>
    </con:router>
</con:pipelineEntry>
