<?xml version="1.0" encoding="UTF-8"?>
<con:pipelineEntry xmlns:con="http://www.bea.com/wli/sb/pipeline/config"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config"
                  xmlns:con2="http://www.bea.com/wli/sb/stages/config"
                  xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config"
                  xmlns:con4="http://www.bea.com/wli/sb/stages/publish/config">
    <con:coreEntry>
        <con:binding type="SOAP" isSOAP12="false" xsi:type="con:SoapBindingType" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
            <con:binding>
                <con:name>DocumentProcessingSOAPBinding</con:name>
                <con:namespace>http://lendwise.com/soa/document</con:namespace>
            </con:binding>
        </con:binding>
    </con:coreEntry>
    <con:router errorHandler="common/faults/FaultHandler">
        <con:pipeline type="request" name="DocumentProcessingRequestPipeline">
            <!-- Stage 1: Java Adapter Callout (OCRProcessor) -->
            <con:stage name="JavaCallout_OCR">
                <con:context/>
                <con:actions>
                    <con3:java-callout varName="ocrConfidence">
                        <con2:id>id_doc_java_01</con2:id>
                        <con3:archive ref="java-adapters/ocr-processor/target/ocr-processor-1.0.0-SNAPSHOT.jar"/>
                        <con3:className>com.lendwise.adapters.OCRProcessor</con3:className>
                        <con3:method>public double calculateConfidence(java.util.Map)</con3:method>
                    </con3:java-callout>
                </con:actions>
            </con:stage>

            <!-- Stage 2: File Archive via FileAdapter -->
            <con:stage name="FileArchive_Publish">
                <con:context/>
                <con:actions>
                    <con4:route>
                        <con2:id>id_doc_file_01</con2:id>
                        <con4:service ref="common/BusinessServices/FileArchiveBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con4:operation>Write</con4:operation>
                        <con4:outboundTransform/>
                    </con4:route>
                </con:actions>
            </con:stage>
        </con:pipeline>

        <con:pipeline type="response" name="DocumentProcessingResponsePipeline">
            <con:stage name="JMSNotification_Publish">
                <con:context/>
                <con:actions>
                    <con4:route>
                        <con2:id>id_doc_jms_01</con2:id>
                        <con4:service ref="common/BusinessServices/JMSNotificationBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con4:operation>Produce</con4:operation>
                        <con4:outboundTransform/>
                    </con4:route>
                </con:actions>
            </con:stage>
        </con:pipeline>

        <con:flow>
            <con:pipeline-node name="DocumentProcessingPipelineNode">
                <con:request>DocumentProcessingRequestPipeline</con:request>
                <con:response>DocumentProcessingResponsePipeline</con:response>
            </con:pipeline-node>
            <con:route-node name="RouteToDocumentComposite">
                <con:context/>
                <con:actions>
                    <con1:route>
                        <con2:id>id_doc_route_01</con2:id>
                        <con1:service ref="DocumentProcessingOSB/BusinessServices/DocumentProcessingSOABusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con1:operation-discover>true</con1:operation-discover>
                    </con1:route>
                </con:actions>
            </con:route-node>
        </con:flow>
    </con:router>
</con:pipelineEntry>
