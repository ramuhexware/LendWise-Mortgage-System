<?xml version="1.0" encoding="UTF-8"?>
<definitions name="UnderwritingProcess"
             targetNamespace="http://lendwise.com/soa/underwriting"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://lendwise.com/soa/underwriting"
             xmlns:types="http://lendwise.com/soa/underwriting/types"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype">

    <!-- Import XSD -->
    <types>
        <xsd:schema>
            <xsd:import namespace="http://lendwise.com/soa/underwriting/types"
                        schemaLocation="xsd/UnderwritingTypes.xsd"/>
        </xsd:schema>
    </types>

    <!-- Messages -->
    <message name="UnderwritingRequest">
        <part name="underwritingRequest" element="types:UnderwritingRequestType"/>
    </message>
    <message name="UnderwritingResponse">
        <part name="underwritingResult" element="types:UnderwritingResultType"/>
    </message>

    <!-- Port Type -->
    <portType name="UnderwritingPortType">
        <operation name="submitForUnderwriting">
            <input message="tns:UnderwritingRequest"/>
            <output message="tns:UnderwritingResponse"/>
        </operation>
    </portType>

    <!-- SOAP Binding -->
    <binding name="UnderwritingSOAPBinding" type="tns:UnderwritingPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="submitForUnderwriting">
            <soap:operation soapAction="http://lendwise.com/soa/underwriting/submitForUnderwriting"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <!-- Service -->
    <service name="UnderwritingService">
        <port name="UnderwritingPort" binding="tns:UnderwritingSOAPBinding">
            <soap:address location="http://localhost:7001/soa-infra/services/lendwise/UnderwritingComposite/UnderwritingService"/>
        </port>
    </service>

    <!-- Partner Link Types -->
    <plnk:partnerLinkType name="UnderwritingPLT">
        <plnk:role name="UnderwritingProvider" portType="tns:UnderwritingPortType"/>
    </plnk:partnerLinkType>

    <plnk:partnerLinkType name="PassthroughPLT">
        <plnk:role name="PassthroughProvider" portType="tns:UnderwritingPortType"/>
    </plnk:partnerLinkType>

</definitions>
