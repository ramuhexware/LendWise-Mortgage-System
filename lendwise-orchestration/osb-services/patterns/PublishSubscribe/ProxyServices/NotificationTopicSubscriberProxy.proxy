<?xml version="1.0" encoding="UTF-8"?>
<ser:xml-service-description xmlns:ser="http://www.bea.com/wli/sb/services"
                             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                             xmlns:tran="http://www.bea.com/wli/sb/transports"
                             xmlns:env="http://www.bea.com/wli/config/env"
                             xmlns:jms="http://www.bea.com/wli/sb/transports/jms">
    <ser:coreEntry>
        <ser:binding type="Mixed" isSOAP12="false" xsi:type="con:MixedBindingType" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
            <con:request type="XML"/>
            <con:response type="None"/>
        </ser:binding>
    </ser:coreEntry>
    <ser:endpointConfig>
        <tran:provider-id>jms</tran:provider-id>
        <tran:inbound>true</tran:inbound>
        <tran:URI>
            <env:value>jms://localhost:7001/jms.TopicConnectionFactory/jms.LoanEventsTopic</env:value>
        </tran:URI>
        <tran:provider-specific xsi:type="jms:JmsEndPointConfiguration">
            <jms:is-queue>false</jms:is-queue>
            <jms:destination-jndi-name>jms/LoanEventsTopic</jms:destination-jndi-name>
            <jms:connection-factory-jndi-name>jms/TopicConnectionFactory</jms:connection-factory-jndi-name>
            <jms:topic-subscription-name>NotificationSubscriber</jms:topic-subscription-name>
            <jms:response-required>false</jms:response-required>
        </tran:provider-specific>
    </ser:endpointConfig>
</ser:xml-service-description>
