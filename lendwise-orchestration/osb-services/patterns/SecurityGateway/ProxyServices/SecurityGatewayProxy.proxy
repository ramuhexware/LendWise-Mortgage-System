<?xml version="1.0" encoding="UTF-8"?>
<ser:xml-service-description xmlns:ser="http://www.bea.com/wli/sb/services"
                             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                             xmlns:tran="http://www.bea.com/wli/sb/transports"
                             xmlns:env="http://www.bea.com/wli/config/env">
    <ser:coreEntry>
        <ser:binding type="SOAP" isSOAP12="false" xsi:type="con:SoapBindingType" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
            <con:binding>
                <con:name>SecurityGatewayBinding</con:name>
                <con:namespace>http://lendwise.com/security/gateway</con:namespace>
            </con:binding>
        </ser:binding>
        <ser:pipeline ref="patterns/SecurityGateway/Pipelines/SecurityGatewayPipeline"/>
    </ser:coreEntry>
    <ser:endpointConfig>
        <tran:provider-id>http</tran:provider-id>
        <tran:inbound>true</tran:inbound>
        <tran:URI>
            <env:value>/gateway/secure</env:value>
        </tran:URI>
    </ser:endpointConfig>
</ser:xml-service-description>
