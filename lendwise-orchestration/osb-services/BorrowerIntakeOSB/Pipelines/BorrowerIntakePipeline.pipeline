<?xml version="1.0" encoding="UTF-8"?>
<con:pipelineEntry xmlns:con="http://www.bea.com/wli/sb/pipeline/config"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config"
                  xmlns:con2="http://www.bea.com/wli/sb/stages/config"
                  xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config"
                  xmlns:con4="http://www.bea.com/wli/sb/stages/publish/config">
    <con:coreEntry>
        <con:binding type="SOAP" isSOAP12="false" xsi:type="con:SoapBindingType" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
            <con:wsdl ref="BorrowerIntakeOSB/WSDL/BorrowerIntakeOSBService"/>
            <con:binding>
                <con:name>BorrowerIntakeBinding</con:name>
                <con:namespace>http://lendwise.com/soa/borrower</con:namespace>
            </con:binding>
        </con:binding>
    </con:coreEntry>
    <con:router errorHandler="common/faults/FaultHandler">
        <con:pipeline type="request" name="BorrowerIntakeRequestPipeline">
            <!-- Stage 1: Validate and Enrich -->
            <con:stage name="ValidateAndEnrich">
                <con:context/>
                <con:actions>
                    <con3:assign varName="trackingId">
                        <con2:id>id_borrower_01</con2:id>
                        <con3:expr>
                            <con2:xqueryText>fn-bea:uuid()</con2:xqueryText>
                        </con3:expr>
                    </con3:assign>
                    <con3:transport-headers copy-all="true">
                        <con2:id>id_borrower_02</con2:id>
                        <con3:header-set>outbound-request</con3:header-set>
                        <con3:header name="X-Tracking-ID" value="expression">
                            <con2:xqueryText>$trackingId</con2:xqueryText>
                        </con3:header>
                    </con3:transport-headers>
                </con:actions>
            </con:stage>

            <!-- Stage 2: Java Adapter Callout (DTICalculator) -->
            <con:stage name="JavaCallout_DTI">
                <con:context/>
                <con:actions>
                    <con3:java-callout varName="dtiResult">
                        <con2:id>id_borrower_java_01</con2:id>
                        <con3:archive ref="java-adapters/dti-calculator/target/dti-calculator-1.0.0-SNAPSHOT.jar"/>
                        <con3:className>com.lendwise.adapters.DTICalculator</con3:className>
                        <con3:method>public static double calculateFrontEndDTI(double, double)</con3:method>
                        <con3:expr>
                            <con2:xqueryText>xs:double($body//*:housingExpense)</con2:xqueryText>
                        </con3:expr>
                        <con3:expr>
                            <con2:xqueryText>xs:double($body//*:grossMonthlyIncome)</con2:xqueryText>
                        </con3:expr>
                    </con3:java-callout>
                </con:actions>
            </con:stage>

            <!-- Stage 3: Audit Log via DbAdapter Business Service -->
            <con:stage name="AuditDB_Publish">
                <con:context/>
                <con:actions>
                    <con4:route>
                        <con2:id>id_borrower_db_01</con2:id>
                        <con4:service ref="common/BusinessServices/AuditDBBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con4:operation>insertAuditLog</con4:operation>
                        <con4:outboundTransform/>
                    </con4:route>
                </con:actions>
            </con:stage>

            <!-- Stage 4: Archive Request Payload via FileAdapter Business Service -->
            <con:stage name="FileArchive_Publish">
                <con:context/>
                <con:actions>
                    <con4:route>
                        <con2:id>id_borrower_file_01</con2:id>
                        <con4:service ref="common/BusinessServices/FileArchiveBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con4:operation>Write</con4:operation>
                        <con4:outboundTransform/>
                    </con4:route>
                </con:actions>
            </con:stage>
        </con:pipeline>

        <con:pipeline type="response" name="BorrowerIntakeResponsePipeline">
            <con:stage name="LogAndNotify">
                <con:context/>
                <con:actions>
                    <!-- Stage 5: Publish JMS Event to Notification Queue -->
                    <con4:route>
                        <con2:id>id_borrower_jms_01</con2:id>
                        <con4:service ref="common/BusinessServices/JMSNotificationBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con4:operation>Produce</con4:operation>
                        <con4:outboundTransform/>
                    </con4:route>
                </con:actions>
            </con:stage>
        </con:pipeline>

        <con:flow>
            <con:pipeline-node name="BorrowerIntakePipelineNode">
                <con:request>BorrowerIntakeRequestPipeline</con:request>
                <con:response>BorrowerIntakeResponsePipeline</con:response>
            </con:pipeline-node>
            <con:route-node name="RouteToSOABpel">
                <con:context/>
                <con:actions>
                    <con1:route>
                        <con2:id>id_route_borrower_01</con2:id>
                        <con1:service ref="BorrowerIntakeOSB/BusinessServices/BorrowerIntakeSOABusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con1:operation-discover>true</con1:operation-discover>
                        <con1:outboundTransform/>
                        <con1:responseTransform/>
                    </con1:route>
                </con:actions>
            </con:route-node>
        </con:flow>
    </con:router>
</con:pipelineEntry>
