<?xml version="1.0" encoding="UTF-8"?>
<con:pipelineEntry xmlns:con="http://www.bea.com/wli/sb/pipeline/config"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config"
                  xmlns:con2="http://www.bea.com/wli/sb/stages/config"
                  xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config">
    <con:coreEntry>
        <con:binding type="AnyXML"/>
    </con:coreEntry>
    <con:router errorHandler="common/faults/FaultHandler">
        <con:pipeline type="request" name="ServiceVirtualizationRequestPipeline">
            <con:stage name="ResolveVirtualEndpoint">
                <con:context/>
                <con:actions>
                    <con3:assign varName="useMockService">
                        <con2:id>id_sv_01</con2:id>
                        <con3:expr>
                            <con2:xqueryText>if (fn:lower-case($inbound/ctx:transport/ctx:request/tp:headers/tp:user-header[@name='X-Use-Mock']/@value) = "true") then true() else false()</con2:xqueryText>
                        </con3:expr>
                    </con3:assign>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:pipeline type="response" name="ServiceVirtualizationResponsePipeline">
            <con:stage name="LogVirtualResponse">
                <con:context/>
                <con:actions/>
            </con:stage>
        </con:pipeline>
        <con:flow>
            <con:pipeline-node name="VirtualizationNode">
                <con:request>ServiceVirtualizationRequestPipeline</con:request>
                <con:response>ServiceVirtualizationResponsePipeline</con:response>
            </con:pipeline-node>
            <con:branch-node type="condition" name="VirtualServiceBranch">
                <con:context/>
                <con:branch-table variable="useMockService">
                    <con:xpath>
                        <con2:xpathText>.</con2:xpathText>
                    </con:xpath>
                    <con:branch name="MOCK_MODE">
                        <con:operator>equals</con:operator>
                        <con:value>true()</con:value>
                        <con:flow>
                            <con:route-node name="RouteToMockBureau">
                                <con:actions>
                                    <con1:route>
                                        <con2:id>id_sv_mock</con2:id>
                                        <con1:service ref="patterns/ServiceVirtualization/BusinessServices/MockCreditBureauBusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                                        <con1:operation-discover>true</con1:operation-discover>
                                    </con1:route>
                                </con:actions>
                            </con:route-node>
                        </con:flow>
                    </con:branch>
                    <con:default-branch>
                        <con:flow>
                            <con:route-node name="RouteToRealBureau">
                                <con:actions>
                                    <con1:route>
                                        <con2:id>id_sv_real</con2:id>
                                        <con1:service ref="UnderwritingOSB/BusinessServices/UnderwritingSOABusinessService" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                                        <con1:operation-discover>true</con1:operation-discover>
                                    </con1:route>
                                </con:actions>
                            </con:route-node>
                        </con:flow>
                    </con:default-branch>
                </con:branch-table>
            </con:branch-node>
        </con:flow>
    </con:router>
</con:pipelineEntry>
